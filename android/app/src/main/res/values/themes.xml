<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind Compose: the Night Watch background, so a cold
         start doesn't flash white in dark mode. -->
    <style name="Theme.Page" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
