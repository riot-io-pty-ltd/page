<?xml version="1.0" encoding="utf-8"?>
<!-- The relay token and session key are the only credentials the relay
     checks, and whoever holds them can type into the Mac's agent sessions.
     Nothing from this app goes to cloud backups or device-to-device
     transfers: a restored copy would carry a pairing, and the Keystore key
     that unwraps it never leaves this device anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
