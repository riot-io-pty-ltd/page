<?xml version="1.0" encoding="utf-8"?>
<!-- The pulse mark (Design/PulseMark.swift): a solid dot inside two rings,
     cyan to sky blue. Drawn inside the adaptive icon's 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Outer ring -->
    <path
        android:pathData="M54,26a28,28 0,1 1,0 56a28,28 0,1 1,0 -56z"
        android:strokeWidth="2"
        android:strokeAlpha="0.35"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="26" android:startY="26" android:endX="82" android:endY="82">
                <item android:offset="0" android:color="#FF5EEAD4" />
                <item android:offset="1" android:color="#FF38BDF8" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Middle ring -->
    <path
        android:pathData="M54,36a18,18 0,1 1,0 36a18,18 0,1 1,0 -36z"
        android:strokeWidth="2.5"
        android:strokeAlpha="0.6"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="36" android:startY="36" android:endX="72" android:endY="72">
                <item android:offset="0" android:color="#FF5EEAD4" />
                <item android:offset="1" android:color="#FF38BDF8" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Dot -->
    <path android:pathData="M54,45a9,9 0,1 1,0 18a9,9 0,1 1,0 -18z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="45" android:startY="45" android:endX="63" android:endY="63">
                <item android:offset="0" android:color="#FF5EEAD4" />
                <item android:offset="1" android:color="#FF38BDF8" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
