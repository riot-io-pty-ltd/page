<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Scanning the Mac's pairing QR code (decoded on the device with ZXing). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 13+: pages arrive as notifications. Asked once, after pairing. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Stay connected" (opt-in): holds the relay WebSocket in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Restarts "Stay connected" (if on) or the 15-minute check after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".PageApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Page"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- page://intervention/<id> opens that page's reply screen. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="page" android:host="intervention" />
            </intent-filter>
        </activity>

        <!--
            "Stay connected": a user-enabled foreground service that keeps one
            WebSocket open to the user's own self-hosted relay, so pages from
            their Mac arrive within seconds without Google services or any push
            provider. specialUse because no standard type fits a long-lived
            messaging connection: dataSync is time-limited (6 h a day on
            Android 15) and can't start at boot, and the connection is not a
            transfer that ends.
        -->
        <service
            android:name=".notify.StayConnectedService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a user-enabled WebSocket open to the user's self-hosted relay so pages (approval requests from AI agents on their computer) arrive instantly without a push provider. Shows an ongoing notification with a Turn off action." />
        </service>

        <receiver
            android:name=".notify.NotificationActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".notify.BootReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
