<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Push-enabled entitlements for paid Apple Developer Program teams.
         Xcode rewrites "development" to "production" when exporting for
         TestFlight / the App Store; the app reports which one it got to the
         relay, so the Worker uses the matching APNs gateway. -->
    <key>aps-environment</key>
    <string>development</string>
    <!-- The widget reads the relay credentials from the shared group. The
         app's own group comes first so its existing items stay where
         they are. -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)$(PAGE_BUNDLE_ID)</string>
        <string>$(AppIdentifierPrefix)$(PAGE_BUNDLE_ID).shared</string>
    </array>
</dict>
</plist>
